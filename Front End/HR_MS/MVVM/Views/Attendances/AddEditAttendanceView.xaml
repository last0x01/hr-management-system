<Window x:Class="HR_MS.MVVM.Views.Attendances.AddEditAttendanceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"

        mc:Ignorable="d"
        Title="Add / Edit Attendance"
        Height="350"
        Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#EFF2F7">


    <Window.Resources>
        <DropShadowEffect x:Key="DropShadowEffect" Color="Gray" BlurRadius="10" ShadowDepth="2"/>
    </Window.Resources>


    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Title ===== -->
        <StackPanel Orientation="Horizontal" Margin="0 0 0 20">
            <icon:PackIconMaterial Kind="CalendarClock"
                                   Width="26"
                                   Height="26"
                                   Foreground="#394867"/>
            <TextBlock Text="{Binding Title}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#394867"
                       Margin="10 0 0 0"/>
        </StackPanel>

        <!-- ===== Content ===== -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="25">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Employee -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0 0 20 15">
                    <TextBlock Text="Employee" FontWeight="SemiBold"/>
                    <ComboBox
                        Width="200"
                        Height="30"
                        IsEditable="True"
                      
                        ItemsSource="{Binding Employees}"
                        SelectedItem="{Binding SelectedEmployee}"
                        DisplayMemberPath="Person.FullName"
                        SelectedValuePath="EmployeeID"
                        StaysOpenOnEdit="True"
                        IsEnabled="{Binding IsNewAttendance}"/>    

                </StackPanel>

                <!-- Date -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0 0 0 15">
                    <TextBlock Text="Date" FontWeight="SemiBold"/>
                    <DatePicker Height="30"
                                SelectedDate="{Binding Attendance.AttendanceDate}"
                                IsEnabled="{Binding IsNewAttendance}"/>
                </StackPanel>
                <!-- Check In -->
                <Border Grid.Row="1" Grid.Column="0" Margin="0 0 20 15"
        Background="#E8F5E9" CornerRadius="8"
        BorderBrush="#2E7D32" BorderThickness="1"
        Padding="10"
        Effect="{DynamicResource DropShadowEffect}">
                    <StackPanel>
                        <TextBlock Text="Check In" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Attendance.CheckIn, StringFormat=HH:mm}"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#2E7D32"
                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Check Out -->
                <Border Grid.Row="1" Grid.Column="1" Margin="0 0 0 15"
        Background="#FFEBEE" CornerRadius="8"
        BorderBrush="#C62828" BorderThickness="1"
        Padding="10"
        Effect="{DynamicResource DropShadowEffect}">
                    <StackPanel>
                        <TextBlock Text="Check Out" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Attendance.CheckOut, StringFormat=HH:mm}"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#C62828"
                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>


                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.14*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                      
                </Grid>

            </Grid>
        </Border>

        <!-- ===== Buttons ===== -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 20 0 0">

            <Button Style="{StaticResource PrimaryButton}"
                     Width="100"
                     Margin="0,0,10,0"
                     Command="{Binding SaveCommand}">

                <StackPanel Orientation="Horizontal">
                    <icon:PackIconMaterial Kind="ContentSave"
                        Width="16"
                        Height="16"
                        Margin="0,0,5,0"/>
                    <TextBlock Text="Save"/>
                </StackPanel>
            </Button>

            <!-- Cancel Button -->
            <Button Style="{StaticResource PrimaryButton}"
                     Width="100"
                     IsCancel="True"
                     Command="{Binding CloseCommand}">      

                <StackPanel Orientation="Horizontal">
                    <icon:PackIconMaterial Kind="Close"
                        Width="16"
                        Height="16"
                        Margin="0,0,5,0"/>
                    <TextBlock Text="Cancel"/>
                </StackPanel>
            </Button>


        </StackPanel>
    </Grid>
</Window>
