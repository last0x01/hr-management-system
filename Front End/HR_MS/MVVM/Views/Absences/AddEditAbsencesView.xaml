<Window x:Class="HR_MS.MVVM.Views.Absences.AddEditAbsencesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Add / Edit Absence"
        Height="400"
        Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#EFF2F7">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Title ===== -->
        <StackPanel Orientation="Horizontal" Margin="0 0 0 20">
            <icon:PackIconMaterial Kind="AccountRemove"
                                   Width="26"
                                   Height="26"
                                   Foreground="#394867"/>
            <TextBlock Text="{Binding Title}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#394867"
                       Margin="10 0 0 0"/>
        </StackPanel>

        <!-- ===== Content ===== -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="25">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Employee -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0 0 20 15">
                    <TextBlock Text="Employee" FontWeight="SemiBold"/>
                    <ComboBox
                        Width="200"
                        Height="30"
                        IsEditable="True"
                        ItemsSource="{Binding Employees}"
                        SelectedItem="{Binding SelectedEmployee}"
                        DisplayMemberPath="Person.FullName"
                        SelectedValuePath="EmployeeID"
                        IsEnabled="{Binding IsNewAbsence}"/>
                </StackPanel>

                <!-- Date -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0 0 0 15">
                    <TextBlock Text="Date" FontWeight="SemiBold"/>
                    <DatePicker Height="30"
                                SelectedDate="{Binding Absence.AbsenceDate}"
                                IsEnabled="{Binding IsNewAbsence}"/>
                </StackPanel>

                <!-- Absence Type -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0 0 20 15">
                    <TextBlock Text="Absence Type" FontWeight="SemiBold"/>
                    <ComboBox
                        Width="200"
                        Height="30"
                        IsEditable="True"
                        ItemsSource="{Binding AbsenceTypes}"
                        SelectedItem="{Binding SelectedAbsenceType}"
                        DisplayMemberPath="Name"
                        SelectedValuePath="AbsenceTypeID"
                        IsEnabled="{Binding IsNewAbsence}"/>
                </StackPanel>

                <!-- Reason -->
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0 0 0 15">
                    <TextBlock Text="Reason" FontWeight="SemiBold"/>
                    <TextBox Style="{StaticResource RoundedTextBox}" Height="30"
                             Text="{Binding Absence.Reason}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Created By -->
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0 10 0 0">
                    <TextBlock Text="Created By:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Username}" Margin="10 0 0 0" VerticalAlignment="Center"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ===== Buttons ===== -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 20 0 0">

            <Button Style="{StaticResource PrimaryButton}"
                     Width="100"
                     Margin="0,0,10,0"
                     Command="{Binding SaveCommand}">
                <StackPanel Orientation="Horizontal">
                    <icon:PackIconMaterial Kind="ContentSave"
                                           Width="16"
                                           Height="16"
                                           Margin="0,0,5,0"/>
                    <TextBlock Text="Save"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource PrimaryButton}"
                     Width="100"
                     IsCancel="True"
                     Command="{Binding CloseCommand}">
                <StackPanel Orientation="Horizontal">
                    <icon:PackIconMaterial Kind="Close"
                                           Width="16"
                                           Height="16"
                                           Margin="0,0,5,0"/>
                    <TextBlock Text="Cancel"/>
                </StackPanel>
            </Button>

        </StackPanel>
    </Grid>
</Window>
